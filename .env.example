# Server
PORT=8787
NODE_ENV=development

# local | openai | anthropic
# Leave empty to use OpenAI when OPENAI_API_KEY is set, otherwise Anthropic,
# otherwise the built-in local planner.
AI_PROVIDER=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional. The dev client proxies /api, so this is only needed if the
# browser talks to the API on a different origin.
CLIENT_ORIGIN=http://localhost:5173
